{
  "name": "order-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "db:generate": "cross-env PRISMA_GENERATE_SKIP_AUTOINSTALL=true prisma generate --schema prisma/schema.prisma",
    "postinstall": "npm run db:generate"
  },
  "dependencies": {
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "zod": "^3.24.1",
    "prom-client": "^15.1.3",
    "@prisma/client": "^6.1.0",
    "amqplib": "^0.10.5",
    "ioredis": "^5.4.1"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8",
    "@types/node": "^22.10.5",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/amqplib": "^0.10.6",
    "prisma": "^6.1.0",
    "cross-env": "^7.0.3"
  }
}
